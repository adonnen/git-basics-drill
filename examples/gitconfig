# =============================================================================
# Example git configuration: the aliases and settings the deck refers to.
#
# Nothing here is required to use git drill. It is the config the cards keep
# pointing at, collected in one place so you can try it without retyping it.
#
# Every line has its own explanation. Read the comment before you paste the
# line, so that nothing in your config surprises you later.
#
# HOW TO USE
#   Open your own config and paste in the parts you want:
#
#       git config --global --edit
#
#   That opens the right file on any OS. Paste under the matching [section]
#   heading, or paste whole sections if you have none yet.
#
#   To try a single alias without editing anything:
#
#       git config --global alias.lg "log --all --oneline --graph --decorate"
#
#   To read back everything that is currently set, and from which file:
#
#       git config --list --show-origin      # the file each setting came from
#       git config --list --show-scope       # system / global / local instead
#       git config --global --list           # only your own, ignoring the repo
#
#   Note that git lower-cases key names when it reads them back, so a setting
#   you wrote as `excludesFile` prints as `excludesfile`. Both spellings work
#   on the way in; the mixed case is for you, not for git.
#
# Take what you like and leave the rest. Anything you regret is one line to
# delete. None of this changes your repositories, only how git behaves.
# =============================================================================


[user]

    # The name and address stamped into every commit you make. Git will not
    # commit without them, and both are permanent and public the moment you
    # push, so choose an address you are willing to have scraped.
    name  = Your Name
    email = you@example.com

    # If you want a different address on work repositories, leave the global
    # one alone and override it inside that repository:
    #     git -C ~/work/project config user.email you@employer.example
    # Or set no global address at all and let git refuse to commit until you
    # have chosen per repository:
    #     git config --global user.useConfigOnly true


[alias]

# --- looking at history ------------------------------------------------------

    # The graph, decorated, across every branch. The one to learn first: you
    # debug history far faster when you can see its shape.
    #   --all       every ref, not just the branch you are on: branches, tags,
    #               remote branches, the stash, and refs other programs keep
    #   --oneline   one line per commit: short hash and subject
    #   --graph     the ASCII rails on the left showing branch and merge
    #   --decorate  the (HEAD -> main, origin/main) labels on the tips
    lg  = log --all --oneline --graph --decorate

    # The same, but only your current branch. Unmerged work on other branches
    # does not appear here, because this form leaves out --all.
    lgb = log --oneline --graph --decorate

    # A richer variant, if you would rather spell the format out than accept
    # what --oneline gives you. The placeholders, in the order they appear:
    #   %C(auto)   colour what follows the way git colours it by default
    #   %h         abbreviated commit hash
    #   %d         ref names on this commit: (HEAD -> main, tag: v1.0)
    #   %s         the subject line of the message
    #   %C(dim)    dim everything after this point
    #   %cr        committer date, relative: "3 days ago"
    #   %an        author name
    #   %C(reset)  back to the terminal's normal colour
    # Everything else inside the quotes (the space, the parentheses, the
    # angle brackets) is printed literally.
    lgv = log --graph --all --pretty=format:'%C(auto)%h%d %s %C(dim)(%cr) <%an>%C(reset)'

    # The same format with the date and author dropped, for when the terminal
    # is narrow or the graph is wide.
    lgs = log --graph --all --pretty=format:'%C(auto)%h%d %s'

    # The same format restricted to the branches you care about. Naming refs
    # explicitly is the middle ground between one branch and all of them; add
    # or remove names to match how your repositories are laid out.
    lgw = log --graph --pretty=format:'%C(auto)%h%d %s %C(dim)(%cr) <%an>%C(reset)' main dev HEAD

    # Branch tips and tags only, interiors dropped. On a repository with
    # thousands of commits this is the "shape of the project" view.
    #   --simplify-by-decoration  keep a commit only if a ref points at it
    skel = log --graph --simplify-by-decoration --oneline --all

    # A busy trunk read as a list of merges, one entry each.
    # Replace `main` with whichever branch you integrate into.
    #   --first-parent  at each merge follow only the branch being merged
    #                   into, so the feature's internal commits stay hidden
    landed = log --first-parent main --oneline

    # Status without the tutorial.
    #   -s  short format: two columns of status letters, one line per path
    #   -b  keep the branch and tracking line at the top, which -s drops
    s = status -sb

    # The last commit, with which files it touched.
    #   -1     stop after one commit
    #   HEAD   start from where you are
    #   --stat a per-file summary of insertions and deletions
    last = log -1 HEAD --stat

    # Word-level diff instead of line-level. Better for prose and docs, where
    # a one-word change otherwise reports the whole paragraph as rewritten.
    wdiff = diff --word-diff=color

    # The full history of one line in one file.
    #   git blame-line 42 src/runner.py
    # The `!` makes git run this through the shell, and the function wrapper
    # exists because git appends your arguments to the end of an alias. A
    # function lets you use them in the middle.
    #   -L <start>,<end>:<file>   trace that line range through history
    blame-line = "!f() { git log -L $1,$1:$2; }; f"


# --- staging and committing --------------------------------------------------

    # What the next commit will contain: the changes in the index compared with
    # the last commit. Reading `git staged` before each commit is a quick way to
    # keep a commit to what you meant.
    staged   = diff --cached

    # What the next commit would leave out: the changes in your working tree
    # that are not in the index. Plain `git diff`, with a name that says which
    # half you are looking at.
    unstaged = diff

    # Fold a forgotten file into the last commit, keeping its message.
    # Stage the file and run this, and you need no "fix typo" commit.
    #   --amend    replace the last commit instead of adding one
    #   --no-edit  reuse its message rather than opening the editor
    # Only for commits you have not pushed: it rewrites history.
    fixit = commit --amend --no-edit

    # Mark a fix for an OLDER commit now; fold it in later with `cleanup`.
    #   git fixup <hash-of-the-commit-it-belongs-to>
    # This writes a commit whose subject is `fixup! <that commit's subject>`,
    # which is the marker the rebase below looks for.
    fixup = commit --fixup

    # Use those markers: git reorders and squashes them for you.
    # Change `main` to whichever branch you branched from.
    #   -i           interactive rebase, so you see the todo list first
    #   --autosquash move each fixup! next to its target and mark it squashed
    cleanup = rebase -i --autosquash main


# --- branches ----------------------------------------------------------------

    # Your branches, most recently worked on first. Answers "what was I doing
    # last week" without opening a tracker.
    #   --sort=-committerdate   newest commit first; the minus reverses it
    #   %(HEAD)                 an asterisk on the branch you are on
    #   %(refname:short)        the branch name without refs/heads/
    #   %(committerdate:relative)  "4 days ago", with no timestamp
    #   %(color:...)/%(color:reset) open and close a colour; close every one
    recent = branch --sort=-committerdate --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:dim)%(committerdate:relative)%(color:reset)'

    # What your current branch adds that the trunk does not: what a reviewer reads.
    # `main..HEAD` means "reachable from HEAD, not reachable from main".
    ahead = log main..HEAD --oneline

    # The first commit this branch added: the oldest line of `ahead`, since
    # log prints newest first and tail keeps the last line. On main that range
    # is empty, so the alias prints the root commit, the only one with no
    # parent (--max-parents=0). A fresh branch with no commits of its own
    # prints nothing. Replace `main` in both places if your trunk is named
    # something else.
    first = "!f() { \
        if [ \"$(git symbolic-ref --short -q HEAD)\" = main ]; then \
            git log --oneline --max-parents=0 HEAD; \
        else \
            git log main..HEAD --oneline | tail -1; \
        fi \
    }; f"

    # Everything queued for the next release, if you use a dev/main pair.
    pending = log main..dev --oneline

    # Delete every local branch already merged into main.
    #   --merged main   list only branches whose tip is an ancestor of main
    #   grep -v -E      drop the lines you never want to feed to the delete:
    #                   `^\*` is the branch you are on, then main and dev
    #   xargs -r        run the delete once with the surviving names; -r
    #                   suppresses the run entirely when nothing survived
    #   branch -d       refuse to delete anything unmerged, so the grep is only
    #                   a convenience
    # Run it occasionally to stay tidy.
    merged-clean = "!git branch --merged main | grep -v -E '^\\*|main|dev' | xargs -r git branch -d"

    # Force your local trunk branches to match the remote, discarding any
    # local commits on them. Useful when main and dev are read-only to
    # you and drift only through pulls; dangerous everywhere else.
    #   fetch --all --prune  update every remote, drop deleted branch refs
    #   branch -f <a> <b>    move branch <a> to point at <b>, no questions
    # Two things to know before you paste this:
    #   - `branch -f` refuses to move the branch you currently have checked
    #     out, so run it from a feature branch, not from main.
    #   - any commit on local main or dev that you have not pushed is gone,
    #     recoverable only through the reflog.
    sync = "!git fetch --all --prune && git branch -f main origin/main && git branch -f dev origin/dev"

    # A force-push with a check. It refuses if the remote branch moved since
    # your last fetch; plain --force does not check. Prefer this to --force, and
    # see push.useForceIfIncludes below for the second half of the check.
    pushf = push --force-with-lease


# --- submodules --------------------------------------------------------------

    # Clone or update every submodule to the commit the parent records.
    #   --init       set up submodules that have never been checked out
    #   --recursive  do the same inside submodules of submodules
    # The command to run after a fresh clone that lacked --recurse-submodules.
    sub-sync = submodule update --init --recursive

    # A short status inside each submodule, so you can see which of them you
    # have left dirty. `foreach` runs the command once per submodule, from
    # that submodule's own root.
    sub-status = submodule foreach --recursive 'git status -sb'

    # Pull each submodule's own default branch. Note this moves them off the
    # commit the parent records, which is a change the parent must then commit.
    # That is the intent here.
    sub-pull = submodule foreach --recursive 'git pull'

    # Run any command in every submodule:
    #   git sub-each 'git log -1 --oneline'
    # Same function trick as blame-line above: git appends arguments to the
    # end of an alias, and "$1" needs to sit inside the quotes.
    sub-each = "!f() { git submodule foreach --recursive \"$1\"; }; f"


# --- destructive, with a guard -----------------------------------------------

    # Show exactly what a full reset would destroy, without destroying it.
    # Run this first, every time.
    #   diff --stat  tracked files with uncommitted changes
    #   clean -nd    -n dry run, -d include directories: what would be removed
    nuke-preview = "!echo '── tracked changes that would be reset ──' && git diff --stat && echo '── untracked files that would be removed ──' && git clean -nd"

    # Working tree back to HEAD, untracked files gone. Asks first, because
    # neither half can be recovered: git never stored uncommitted work, so no
    # reflog can return it.
    #   reset --hard HEAD  discard changes to tracked files
    #   clean -fd          -f actually delete, -d directories too
    nuke = "!f() { \
        echo 'This discards ALL uncommitted changes AND untracked files.'; \
        printf 'Are you sure? (y/N) '; \
        read ans; \
        if [ \"$ans\" = 'y' ] || [ \"$ans\" = 'Y' ]; then \
            git reset --hard HEAD && git clean -fd && echo 'Done.'; \
        else \
            echo 'Aborted.'; \
        fi \
    }; f"


# --- housekeeping ------------------------------------------------------------

    # List these aliases again when you have forgotten what you named
    # something. The regexp anchors at `alias.` so nothing else matches.
    aliases = config --get-regexp ^alias\\.


# =============================================================================
# SETTINGS
# The aliases above save typing. The settings change how git behaves.
# =============================================================================

[init]
    # Name the first branch of every new repository `main`. Affects only
    # repositories created from now on; existing ones keep whatever they have.
    defaultBranch = main

[pull]
    # Replay your local commits on top of what arrives, instead of building a
    # merge commit for every pull. Keeps history readable on a shared trunk.
    rebase = true

[rebase]
    # Start a rebase even with a dirty working tree: git stashes your changes,
    # rebases, and puts them back. One less interruption.
    autoStash = true

    # Recognise `fixup!` and `squash!` markers automatically, so `git fixup`
    # above needs no manual reordering in the todo list.
    autoSquash = true

[merge]
    # Write the common ancestor into every conflict, between ||||||| and
    # =======, instead of showing only the two sides. Two versions of a line
    # do not tell you which side changed. The ancestor does, and without it you
    # can undo somebody's fix without noticing. It also removes the parts both
    # sides changed identically from the conflict, so only the real disagreement
    # is left between the markers. Needs git 2.35 or newer; older versions
    # understand `diff3`, which is the same idea without the tidying.
    conflictStyle = zdiff3

    # Which program `git mergetool` opens. Ask your own machine what it has with
    # `git mergetool --tool-help`, since the list depends on what is installed.
    # Left commented because the answer is personal:
    #   tool = vscode
    #   tool = opendiff        # FileMerge, ships with Xcode
    #   tool = vimdiff

[mergetool]
    # Do not leave a `.orig` copy of every file the merge tool touched.
    keepBackup = false

[rerere]
    # rerere stands for "reuse recorded resolution". Git stores your fix for a
    # conflict and uses it when that exact conflict appears again, which helps
    # when you rebase onto a moving trunk many times.
    enabled = true

[fetch]
    # Forget `origin/...` names when their branch is deleted on the server.
    # Without this, `git branch -r` fills with the names of deleted branches.
    prune = true

[push]
    # Pushing a new branch creates and links its upstream instead of failing
    # with "no upstream branch". This saves a step if you make one branch per
    # task. Needs git 2.37 or newer.
    #
    # Without it you have to say so once per branch:
    #     git push --set-upstream origin <branch>
    #     git push -u origin HEAD          # same thing, no name to retype
    autoSetupRemote = true

    # Strengthen --force-with-lease: refuse the push unless the server's commit
    # has been part of your local branch, which git checks in the branch's
    # reflog. This closes a gap: a fetch that runs in the background, in an
    # editor or a shell prompt, moves your remote-tracking branch and lets the
    # lease pass even though that commit is not in your branch.
    #
    # It has no effect on plain `git push --force`, or on
    # `--force-with-lease=<ref>:<expect>`, where you name the expected commit
    # yourself. So keep the habit as well as the setting: push with the `pushf`
    # alias above.
    useForceIfIncludes = true

[diff]
    # A different way of working out a diff. It tends to put hunk boundaries
    # where a person would, while the default (myers) can produce diffs that mix
    # the end of one function with the start of the next.
    algorithm = histogram

    # Colour lines that moved rather than showing them as a deletion here and
    # an addition there. This is the setting that detects moved code; the
    # algorithm above does not. Off by default, so uncomment to try it:
    #   colorMoved = zebra

[color]
    # Colour when the output is a terminal, and no colour when it is piped
    # into a file or another program. `auto` has been the default since git
    # 1.8.4. Set it explicitly if you inherited a config that turned it off.
    ui = auto

[core]
    # What comes from your machine, such as OS metadata and editor swap files,
    # belongs in one global ignore file, so no project needs its own entry.
    # Create it first:
    #   printf '.DS_Store\n._*\n*.swp\n.idea/\n' >> ~/.gitignore_global
    excludesFile = ~/.gitignore_global


# =============================================================================
# IF YOU USE SUBMODULES
# Uncomment these. They prevent the three classic submodule failures: pulling
# without updating them, committing a parent that points at a submodule commit
# nobody else has, and a clean-looking status hiding dirty submodules.
# The aliases under "submodules" above cover the manual half of the same job.
# =============================================================================

# [submodule]
#     # Make --recurse-submodules the default for the commands that accept it,
#     # so checkout and pull move your submodules to the commit the parent
#     # records instead of leaving them where they were.
#     recurse = true

# [push]
#     # Refuse to push a parent whose recorded submodule commits are not on the
#     # submodule's own remote. Without it you can push a parent that nobody
#     # else can check out. `on-demand` pushes them for you instead of
#     # refusing; `check` is the conservative choice.
#     recurseSubmodules = check

# [status]
#     # Add a line to `git status` for each submodule that has drifted from the
#     # commit the parent records, which the default output leaves out.
#     submoduleSummary = true

# [diff]
#     # Show a submodule's change as the list of commits between the old and
#     # new pointer. The default shows only the two hashes.
#     submodule = log


# =============================================================================
# WRITTEN BY OTHER PROGRAMS
# Some tools append their own sections. Recognise them so you do not mistake
# them for something you chose. Do not write them by hand: run the tool.
# =============================================================================

# [filter "lfs"]
#     # Git Large File Storage, added by `git lfs install`. The four lines
#     # hook LFS into git's clean/smudge filter so that large files are
#     # replaced by pointers on the way into the object database and fetched
#     # back on checkout. `required = true` makes a failure in the filter an
#     # error rather than a silent pass-through of the pointer text.
#     required = true
#     clean    = git-lfs clean -- %f
#     smudge   = git-lfs smudge -- %f
#     process  = git-lfs filter-process
